<!DOCTYPE html>
<html>
  <head>
    <base target="_top">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard Admin Final</title>
    <script src="https://cdn.jsdelivr.net/npm/html2canvas@1.4.1/dist/html2canvas.min.js"></script>

    <style>
      :root {
        --bg1: #08111f;
        --bg2: #0f172a;
        --bg3: #111827;
        --panel: rgba(17, 24, 39, 0.90);
        --border: rgba(255,255,255,0.08);
        --text: #e5e7eb;
        --muted: #9ca3af;
        --primary: #3b82f6;
        --secondary: #8b5cf6;
        --shadow: 0 16px 40px rgba(0,0,0,0.30);
      }

      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      html, body {
        min-height: 100%;
      }

      body {
        font-family: Arial, sans-serif;
        color: var(--text);
        background:
          radial-gradient(circle at top left, rgba(59,130,246,0.18), transparent 24%),
          radial-gradient(circle at top right, rgba(16,185,129,0.12), transparent 26%),
          radial-gradient(circle at bottom center, rgba(139,92,246,0.16), transparent 34%),
          linear-gradient(135deg, var(--bg1), var(--bg2) 52%, var(--bg3));
      }

      .app {
        display: flex;
        min-height: 100vh;
      }

      .sidebar {
        width: 250px;
        background: rgba(2, 6, 23, 0.84);
        backdrop-filter: blur(16px);
        border-right: 1px solid var(--border);
        padding: 24px 18px;
        position: sticky;
        top: 0;
        height: 100vh;
      }

      .brand {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 28px;
      }

      .brand-badge {
        width: 44px;
        height: 44px;
        border-radius: 14px;
        background: linear-gradient(135deg, #3b82f6, #8b5cf6, #10b981);
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: bold;
        color: #fff;
        box-shadow: var(--shadow);
      }

      .brand h1 {
        font-size: 18px;
        line-height: 1.2;
      }

      .brand p {
        font-size: 12px;
        color: var(--muted);
      }

      .nav {
        display: flex;
        flex-direction: column;
        gap: 10px;
      }

      .nav button {
        width: 100%;
        border: 1px solid transparent;
        background: transparent;
        color: var(--text);
        padding: 14px 16px;
        border-radius: 14px;
        text-align: left;
        font-size: 14px;
        cursor: pointer;
        transition: 0.22s ease;
      }

      .nav button:hover,
      .nav button.active {
        background: linear-gradient(135deg, rgba(59,130,246,0.20), rgba(139,92,246,0.18));
        border-color: rgba(255,255,255,0.09);
        transform: translateX(4px);
      }

      .sidebar-footer {
        position: absolute;
        left: 18px;
        right: 18px;
        bottom: 20px;
        background: rgba(255,255,255,0.04);
        border: 1px solid var(--border);
        border-radius: 16px;
        padding: 14px;
        font-size: 12px;
        color: var(--muted);
      }

      .main {
        flex: 1;
        padding: 22px;
      }

      .section {
        display: none;
      }

      .section.active {
        display: block;
      }

      .panel {
        background: var(--panel);
        border: 1px solid var(--border);
        border-radius: 24px;
        padding: 20px;
        box-shadow: var(--shadow);
      }

      .panel h3 {
        font-size: 22px;
        margin-bottom: 10px;
      }

      .panel-sub {
        color: var(--muted);
        font-size: 13px;
        margin-bottom: 16px;
      }

      .panel-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 16px;
        flex-wrap: wrap;
        margin-bottom: 18px;
      }

      .live-clock-box {
        min-width: 220px;
        padding: 14px 18px;
        border-radius: 16px;
        border: 1px solid rgba(255,255,255,0.10);
        background: linear-gradient(135deg, rgba(59,130,246,0.16), rgba(139,92,246,0.16), rgba(16,185,129,0.12));
        box-shadow: var(--shadow);
        text-align: center;
      }

      .live-clock-label {
        font-size: 12px;
        color: #dbeafe;
        margin-bottom: 6px;
      }

      .live-clock-time {
        font-size: 28px;
        font-weight: bold;
        color: #fff;
        line-height: 1.08;
      }

      .live-clock-date {
        margin-top: 4px;
        font-size: 13px;
        color: #e5e7eb;
      }

      input[type="text"],
      input[type="date"],
      select,
      textarea {
        width: 100%;
        padding: 13px 14px;
        border-radius: 14px;
        border: 1px solid rgba(255,255,255,0.10);
        background: rgba(255,255,255,0.05);
        color: white;
        outline: none;
        font-size: 14px;
      }

      input::placeholder,
      textarea::placeholder {
        color: #9ca3af;
      }

      select option {
        color: #111827;
      }

      textarea {
        resize: vertical;
      }

      input:focus,
      select:focus,
      textarea:focus {
        border-color: rgba(255,255,255,0.18);
        box-shadow: 0 0 0 3px rgba(59,130,246,0.12);
      }

      .btn {
        border: none;
        border-radius: 14px;
        padding: 13px 16px;
        background: linear-gradient(135deg, var(--primary), var(--secondary));
        color: white;
        font-weight: bold;
        cursor: pointer;
        transition: 0.22s ease;
      }

      .btn:hover {
        transform: translateY(-2px);
        opacity: 0.96;
      }

      .btn.secondary {
        background: rgba(255,255,255,0.08);
        border: 1px solid rgba(255,255,255,0.10);
      }

      .copy-live-btn {
        background: linear-gradient(180deg, #ff00cc 0%, #7b2cff 55%, #3b82f6 100%);
        border: 1px solid rgba(255,255,255,0.22);
        box-shadow:
          0 8px 24px rgba(123,44,255,0.30),
          inset 0 1px 0 rgba(255,255,255,0.20);
        position: relative;
        overflow: hidden;
      }

      .copy-live-btn::before {
        content: "";
        position: absolute;
        top: 0;
        left: -120%;
        width: 90%;
        height: 100%;
        background: linear-gradient(90deg, transparent, rgba(255,255,255,0.26), transparent);
        transform: skewX(-20deg);
        transition: left 0.6s ease;
      }

      .copy-live-btn:hover::before {
        left: 130%;
      }

      .copy-live-btn.success {
        background: linear-gradient(180deg, #8b5cf6 0%, #6366f1 55%, #3b82f6 100%);
      }

      .empty-state {
        color: var(--muted);
        text-align: center;
        padding: 18px 10px;
      }

      .pkcs-dual-layout,
      .rek-dual-layout,
      .prediksi-dual-layout {
        display: grid;
        grid-template-columns: 320px 1fr;
        gap: 20px;
        align-items: start;
      }

      .pkcs-box,
      .rek-box,
      .prediksi-box {
        background: rgba(255,255,255,0.03);
        border: 1px solid var(--border);
        border-radius: 18px;
        padding: 14px;
      }

      .pkcs-box-title,
      .rek-box-title,
      .prediksi-box-title {
        font-size: 16px;
        font-weight: bold;
        margin-bottom: 14px;
        color: #fff;
      }

      .pkcs-keyword-list,
      .rekening-list,
      .prediksi-list {
        max-height: 590px;
        overflow-y: auto;
        display: flex;
        flex-direction: column;
        gap: 10px;
        padding-right: 4px;
      }

      .pkcs-keyword-item,
      .rekening-item,
      .prediksi-item {
        padding: 14px 16px;
        border-radius: 14px;
        border: 1px solid rgba(255,255,255,0.08);
        background: rgba(255,255,255,0.04);
        color: #fff;
        font-weight: bold;
        cursor: pointer;
        transition: 0.2s ease;
      }

      .pkcs-keyword-item {
        text-transform: uppercase;
      }

      .pkcs-keyword-item:hover {
        background: linear-gradient(135deg, rgba(59,130,246,0.20), rgba(139,92,246,0.16));
        transform: translateX(4px);
      }

      .pkcs-keyword-item.active {
        background: linear-gradient(135deg, rgba(59,130,246,0.28), rgba(139,92,246,0.24));
      }

      .pkcs-result-box {
        min-height: 110px;
        max-height: 620px;
        overflow-y: auto;
        padding: 24px;
        border-radius: 18px;
        white-space: pre-wrap;
        text-align: center;
        height: auto;
        background: linear-gradient(135deg, rgba(244,114,182,0.92), rgba(216,180,254,0.92));
        color: #111827;
        font-size: 18px;
        line-height: 1.8;
        font-weight: 500;
      }

      .pkcs-result-box.copy-success {
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 28px;
        font-weight: 800;
        letter-spacing: 6px;
        color: #6d28d9;
      }

      .pkcs-box-right.flash,
      .prediksi-box-right.flash {
        animation: boxFlash 0.28s ease;
      }

      @keyframes boxFlash {
        0% { transform: scale(0.995); opacity: 0.82; }
        100% { transform: scale(1); opacity: 1; }
      }

      .rek-search-input {
        width: 100%;
        padding: 13px 14px;
        border-radius: 12px;
        border: 1px solid rgba(255,255,255,0.18);
        background: rgba(0,0,0,0.42);
        color: white;
        outline: none;
        font-size: 22px;
        font-weight: 700;
        text-align: center;
      }

      .rek-search-input::placeholder {
        color: #9ca3af;
        font-size: 14px;
        font-weight: 500;
      }

      .rekening-title {
        color: #ffffff;
        font-size: 16px;
        font-weight: 800;
        line-height: 1.5;
        white-space: pre-wrap;
        word-break: break-word;
      }

      .prediksi-item {
        text-align: center;
        text-transform: uppercase;
        background: linear-gradient(180deg, rgba(25,35,70,0.92), rgba(10,20,55,0.95));
        box-shadow: inset 0 0 0 1px rgba(255,0,255,0.05);
      }

      .prediksi-item:hover {
        transform: translateY(-2px);
        border-color: rgba(255, 0, 255, 0.35);
        box-shadow: 0 0 16px rgba(255,0,255,0.18), inset 0 0 14px rgba(255,0,255,0.06);
      }

      .prediksi-item.active {
        background: linear-gradient(180deg, #042a70, #021d55);
        border-color: rgba(0,255,255,0.45);
        box-shadow: 0 0 18px rgba(0,255,255,0.16), inset 0 0 16px rgba(0,255,255,0.08);
      }

      .prediksi-result-card {
        min-height: 140px;
        max-height: 620px;
        overflow-y: auto;
        padding: 24px;
        border-radius: 18px;
        white-space: pre-wrap;
        text-align: center;
        background:
          linear-gradient(180deg, rgba(50,15,25,0.92), rgba(15,20,40,0.92)),
          rgba(255,255,255,0.03);
        border: 1px solid rgba(255, 0, 255, 0.18);
        box-shadow:
          0 0 20px rgba(255,0,255,0.14),
          inset 0 0 30px rgba(255,255,255,0.03);
        color: #ffffff;
        line-height: 1.7;
        font-size: 16px;
        font-weight: 700;
      }

      .image-gallery-cards {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
        gap: 18px;
      }

      .image-card-v2 {
        background: linear-gradient(180deg, rgba(255,255,255,0.05), rgba(255,255,255,0.03));
        border: 2px solid rgba(255, 221, 51, 0.7);
        border-radius: 18px;
        padding: 12px;
        box-shadow: 0 10px 24px rgba(0,0,0,0.22);
        transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
        position: relative;
        overflow: hidden;
        cursor: pointer;
      }

      .image-card-v2:hover {
        transform: translateY(-8px) scale(1.02);
        border-color: rgba(255, 230, 120, 0.95);
      }

      .image-card-v2-title {
        font-size: 15px;
        font-weight: 800;
        color: #ffffff;
        text-align: center;
        margin-bottom: 10px;
        text-transform: uppercase;
        line-height: 1.4;
      }

      .image-card-v2-media {
        border-radius: 14px;
        overflow: hidden;
        background: rgba(0,0,0,0.18);
      }

      .image-card-v2-media img {
        width: 100%;
        height: 220px;
        object-fit: cover;
        display: block;
        transition: transform 0.35s ease, filter 0.35s ease;
      }

      .image-card-v2:hover .image-card-v2-media img {
        transform: scale(1.06);
        filter: brightness(1.05) saturate(1.08);
      }

      .image-card-v2-empty {
        color: var(--muted);
        text-align: center;
        padding: 24px 10px;
        background: rgba(255,255,255,0.03);
        border-radius: 14px;
      }

      .image-modal {
        position: fixed;
        inset: 0;
        z-index: 9999;
        display: none;
      }

      .image-modal.show {
        display: block;
      }

      .image-modal-backdrop {
        position: absolute;
        inset: 0;
        background: rgba(0,0,0,0.72);
        backdrop-filter: blur(4px);
      }

      .image-modal-content {
        position: relative;
        z-index: 2;
        width: min(92vw, 900px);
        max-height: 90vh;
        margin: 4vh auto;
        background: linear-gradient(180deg, rgba(17,24,39,0.96), rgba(15,23,42,0.96));
        border: 1px solid rgba(255,255,255,0.10);
        border-radius: 22px;
        padding: 18px;
        box-shadow: 0 24px 60px rgba(0,0,0,0.45);
      }

      .image-modal-title {
        color: #fff;
        font-size: 18px;
        font-weight: 800;
        text-align: center;
        margin-bottom: 14px;
        text-transform: uppercase;
        padding-right: 36px;
      }

      .image-modal-img {
        width: 100%;
        max-height: 72vh;
        object-fit: contain;
        display: block;
        border-radius: 16px;
        background: rgba(255,255,255,0.03);
      }

      .image-modal-close {
        position: absolute;
        top: 10px;
        right: 12px;
        width: 38px;
        height: 38px;
        border: none;
        border-radius: 999px;
        background: rgba(255,255,255,0.10);
        color: #fff;
        font-size: 26px;
        line-height: 1;
        cursor: pointer;
      }

      /* =========================
         SYAIR
      ========================= */

      .syair-layout {
        display: grid;
        grid-template-columns: 360px 1fr;
        gap: 20px;
        align-items: start;
      }

      .syair-sidebar,
      .syair-preview-panel {
        background: rgba(255,255,255,0.03);
        border: 1px solid rgba(255,255,255,0.08);
        border-radius: 20px;
      }

      .syair-sidebar {
        padding: 18px;
        max-height: 88vh;
        overflow-y: auto;
      }

      .syair-head {
        display: flex;
        align-items: center;
        gap: 14px;
        margin-bottom: 20px;
      }

      .syair-icon {
        width: 44px;
        height: 44px;
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: linear-gradient(135deg, rgba(59,130,246,0.22), rgba(139,92,246,0.22));
        border: 1px solid rgba(255,255,255,0.10);
        color: #fff;
        font-size: 20px;
      }

      .syair-group {
        margin-bottom: 16px;
      }

      .syair-label {
        display: block;
        margin-bottom: 8px;
        font-size: 12px;
        font-weight: 800;
        color: #dbeafe;
        letter-spacing: 0.6px;
      }

      .syair-textarea {
        min-height: 220px;
        font-size: 18px;
        line-height: 1.7;
        white-space: pre-wrap;
      }

      .syair-info-box {
        background: rgba(255,255,255,0.05);
        border: 1px solid rgba(255,255,255,0.07);
        border-radius: 14px;
        padding: 12px 14px;
        font-size: 13px;
        color: #cbd5e1;
        margin-bottom: 16px;
        line-height: 1.6;
      }

      .syair-actions {
        display: grid;
        grid-template-columns: 1fr 110px;
        gap: 12px;
      }

      .syair-preview-panel {
        padding: 12px 14px 14px;
      }

      .syair-preview-top {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 14px;
        margin-bottom: 14px;
      }

      .syair-preview-title {
        display: flex;
        align-items: center;
        gap: 14px;
      }

      .syair-preview-frame {
        background: linear-gradient(180deg, rgba(15,23,42,0.90), rgba(11,16,32,0.92));
        border: 1px solid rgba(255,255,255,0.06);
        border-radius: 22px;
        min-height: 560px;
        padding: 14px;
      }

.syair-preview-area {
    min-height: 570px;
    display: flex;
    align-items: center;
    justify-content: space-around;
}

      .syair-card {
        width: min(100%, 1000px);
        aspect-ratio: 1500 / 1000;
        position: relative;
        border-radius: 14px;
        overflow: hidden;
        background: #d9d9d9;
        box-shadow: 0 18px 40px rgba(0,0,0,0.30);
      }

      .syair-bg {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
      }

