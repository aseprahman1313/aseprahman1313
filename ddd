        line-height: 1.02;
        border-radius: 76px;
        text-align: center;
        z-index: 3;
        color: #111;
        font-weight: 900;
        font-size: clamp(11px, 1.35vw, 20px);
        letter-spacing: 0.4px;
    }

      .num-grid {
        position: absolute;
        z-index: 3;
        display: grid;
        gap: 0;
        background: rgba(220,220,220,0.18);
      }

.num-cell {
    display: flex;
    align-items: center;
    justify-content: center;
    border: 2px solid rgba(0, 0, 0, 0.82);
    color: #111;
    border-radius: 21px;
    background: rgb(191 189 188 / 0%);
    font-weight: 500;
    font-size: clamp(16px, 2vw, 28px);
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0%);
    position: relative;
    width: 100%;
    height: 100%;
    box-sizing: border-box;
}


