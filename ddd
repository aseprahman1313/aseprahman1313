        const searchInput = document.getElementById("pkcsSearchInput");
        const rightBox = document.querySelector(".pkcs-box-right");

        if (resultEl) resultEl.textContent = selected[1] || "-";

        if (rightBox) {
          rightBox.classList.remove("flash");
          void rightBox.offsetWidth;
          rightBox.classList.add("flash");
        }

        if (searchInput) {
          searchInput.value = "";
          searchInput.blur();
        }

        filteredPkcsData = [];
        selectedPkcsIndex = -1;
        showPkcsPrompt();
      }

      function copyPkcsResult() {
        const resultEl = document.getElementById("pkcsResultBox");
        const copyBtn = document.getElementById("copyPkcsBtn");
        const text = resultEl ? resultEl.textContent : "";

        if (!text) {
          updateStatus("Tidak ada hasil PK CS yang bisa dicopy");
          return;
        }

        pkcsOriginalResultText = text;

        const onSuccess = () => {
          updateStatus("Hasil PK CS berhasil dicopy");
          if (copyBtn) {
            copyBtn.classList.add("success");
            copyBtn.textContent = "Berhasil Dicopy";
          }
          if (resultEl) {
            resultEl.classList.add("copy-success");
            resultEl.innerHTML = "✔✔✔";
          }
          setTimeout(() => {
            if (resultEl) {
              resultEl.classList.remove("copy-success");
              resultEl.textContent = pkcsOriginalResultText;
            }
            if (copyBtn) {
              copyBtn.classList.remove("success");
              copyBtn.textContent = "Copy";
            }
          }, 1800);
        };

        const onFail = () => updateStatus("Gagal copy hasil PK CS");

        if (navigator.clipboard && window.isSecureContext) {
          navigator.clipboard.writeText(text).then(onSuccess).catch(() => fallbackCopy(text, onSuccess, onFail));
        } else {
          fallbackCopy(text, onSuccess, onFail);
        }
      }

      function renderRekeningList(data) {
        const listEl = document.getElementById("rekeningList");
        if (!listEl) return;

        if (!data || !data.length) {
          listEl.innerHTML = '<div class="empty-state">Tidak ada data rekening ditemukan.</div>';
          return;
        }

        listEl.innerHTML = data.map(item => {
          const val = Array.isArray(item) ? item[0] : item;
          return `
            <div class="rekening-item">
              <div class="rekening-title">${escapeHtml(val)}</div>
            </div>
          `;
        }).join("");
      }

      function filterRekeningList() {
        const input = document.getElementById("rekeningSearchInput");
        const keyword = String(input ? input.value : "").trim().toLowerCase();
        const source = dashboardData.dropdown3 || [];

        if (!keyword) {
          document.getElementById("rekeningList").innerHTML = '<div class="empty-state">Ketik nomor atau nama rekening...</div>';
          return;
        }

        const filtered = source.filter(row => {
          const text = String(Array.isArray(row) ? row[0] : row).toLowerCase();
          return text.includes(keyword);
        });

        renderRekeningList(filtered);
      }

      function renderPrediksiList(data) {
        const listEl = document.getElementById("prediksiList");
        if (!listEl) return;

        if (!data || !data.length) {
          listEl.innerHTML = '<div class="empty-state">Tidak ada pasaran ditemukan.</div>';
          document.getElementById("prediksiResultCard").textContent = "Tidak ada hasil prediksi.";
          return;
        }

        listEl.innerHTML = data.map((row, index) => `
          <div class="prediksi-item ${index === selectedPrediksiIndex ? "active" : ""}" onclick="selectPrediksiItem(${index})">
            ${escapeHtml(row[0])}
          </div>
        `).join("");
      }

      function filterPrediksiList() {
        const input = document.getElementById("prediksiSearchInput");
        const keyword = String(input ? input.value : "").trim().toLowerCase();
        const source = dashboardData.dropdown2 || [];

        if (!keyword) {
          filteredPrediksiData = [...source];
        } else {
          filteredPrediksiData = source.filter(row => String(row[0] || "").toLowerCase().includes(keyword));
        }

        selectedPrediksiIndex = filteredPrediksiData.length ? 0 : -1;
        renderPrediksiList(filteredPrediksiData);

        const resultEl = document.getElementById("prediksiResultCard");
        if (resultEl) {
          resultEl.textContent = filteredPrediksiData.length ? (filteredPrediksiData[0][1] || "-") : "Tidak ada hasil prediksi.";
        }
      }

      function selectPrediksiItem(index) {
        const selected = filteredPrediksiData[index];
        if (!selected) return;

        selectedPrediksiIndex = index;
        const resultEl = document.getElementById("prediksiResultCard");
        const rightBox = document.querySelector(".prediksi-box-right");

        if (resultEl) resultEl.textContent = selected[1] || "-";

        document.querySelectorAll(".prediksi-item").forEach((item, i) => {
          item.classList.toggle("active", i === index);
        });

        if (rightBox) {
          rightBox.classList.remove("flash");
          void rightBox.offsetWidth;
          rightBox.classList.add("flash");
        }
      }

      function copyPrediksiResult() {
        const resultEl = document.getElementById("prediksiResultCard");
        const copyBtn = document.getElementById("copyPrediksiBtn");
        const text = resultEl ? resultEl.textContent : "";

        if (!text || text === "-" || text === "Tidak ada hasil prediksi.") {
          updateStatus("Tidak ada prediksi yang bisa dicopy");
          return;
        }

        const onSuccess = () => {
          updateStatus("Prediksi berhasil dicopy");
          if (copyBtn) {
            copyBtn.classList.add("success");
            copyBtn.textContent = "Berhasil Dicopy";
          }
          setTimeout(() => {
            if (copyBtn) {
              copyBtn.classList.remove("success");
              copyBtn.textContent = "Copy";
            }
          }, 1800);
        };

        const onFail = () => updateStatus("Gagal copy prediksi");

        if (navigator.clipboard && window.isSecureContext) {
          navigator.clipboard.writeText(text).then(onSuccess).catch(() => fallbackCopy(text, onSuccess, onFail));
        } else {
          fallbackCopy(text, onSuccess, onFail);
        }
      }

      function renderStaticImageCards(data = staticImageData) {
        const gallery = document.getElementById("imageGallery");
        if (!gallery) return;

        if (!data.length) {
          gallery.innerHTML = '<div class="image-card-v2-empty">Tidak ada gambar ditemukan.</div>';
          return;
        }

        gallery.innerHTML = data.map(item => `
          <div class="image-card-v2" onclick="openImageModal('${escapeAttribute(item.title)}','${escapeAttribute(item.url)}')">
            <div class="image-card-v2-title">${escapeHtml(item.title)}</div>
            <div class="image-card-v2-media">
              <img
                src="${escapeAttribute(item.url)}"
                alt="${escapeAttribute(item.title)}"
                loading="lazy"
                onerror="this.parentElement.innerHTML='<div class=&quot;image-card-v2-empty&quot;>Gambar gagal dimuat</div>'"
              >
            </div>
          </div>
        `).join("");
      }

      function filterStaticImageCards() {
        const input = document.getElementById("gambarSearchInput");
        const keyword = String(input ? input.value : "").trim().toLowerCase();

        if (!keyword) {
          renderStaticImageCards(staticImageData);
          return;
        }

        const filtered = staticImageData.filter(item => String(item.title).toLowerCase().includes(keyword));
        renderStaticImageCards(filtered);
      }

      function openImageModal(title, url) {
        const modal = document.getElementById("imagePreviewModal");
        const img = document.getElementById("imageModalImg");
        const titleEl = document.getElementById("imageModalTitle");
        if (!modal || !img || !titleEl) return;
        titleEl.textContent = title || "Preview Gambar";
        img.src = url || "";
        modal.classList.add("show");
        document.body.style.overflow = "hidden";
      }

      function closeImageModal() {
        const modal = document.getElementById("imagePreviewModal");
        const img = document.getElementById("imageModalImg");
        if (modal) modal.classList.remove("show");
        if (img) img.src = "";
        document.body.style.overflow = "";
      }

      function getTodayInputValue() {
        const d = new Date();
        const y = d.getFullYear();
        const m = String(d.getMonth() + 1).padStart(2, "0");
        const day = String(d.getDate()).padStart(2, "0");
        return `${y}-${m}-${day}`;
      }

      function formatSyairDateParts(dateValue) {
        const d = dateValue ? new Date(dateValue + "T00:00:00") : new Date();
        return {
          weekday: d.toLocaleDateString("id-ID", { weekday: "long" }),
          longDate: d.toLocaleDateString("id-ID", { day: "numeric", month: "long", year: "numeric" }),
          fullUpper: d.toLocaleDateString("id-ID", { day: "2-digit", month: "long", year: "numeric" }).toUpperCase()
        };
      }

      function randInt(min, max) {
        return Math.floor(Math.random() * (max - min + 1)) + min;
      }

      function randDigit() {
        return String(randInt(0, 9));
      }

      function randTwoDigit() {
        return String(randInt(0, 99)).padStart(2, "0");
      }

      function generateSyairNumbers() {
        return {
          bb: [randTwoDigit(), randTwoDigit(), randTwoDigit(), randTwoDigit(), randTwoDigit()],
          arah: [randDigit(), randDigit(), randDigit(), randDigit()],
          colok: [randDigit(), randDigit()],
          jaga: [randDigit(), randDigit()],
          ekor: [randDigit(), randDigit()],
          kepala: [randDigit(), randDigit()],
          bbfs: [randDigit(), randDigit(), randDigit(), randDigit(), randDigit(), randDigit(), randDigit()],
          angkaMain: [randDigit(), randDigit(), randDigit()],
          jitu: [randDigit(), randDigit()]
        };
      }

      function getElValue(id, fallback = "") {
        const el = document.getElementById(id);
        return el ? (el.value || fallback) : fallback;
      }

      function updateSyairCopyText() {
        const marketKey = getElValue("syairMarketSelect", "BANGKOK");
        const dateValue = getElValue("syairDateInput", getTodayInputValue());
        const cfg = syairMarketConfig[marketKey] || syairMarketConfig.BANGKOK;
        const dateInfo = formatSyairDateParts(dateValue);
        const copyEl = document.getElementById("syairCopyText");
        if (copyEl) {
          copyEl.value = `${cfg.label} - ${dateInfo.fullUpper}`;
        }
      }

      function buildNumCells(arr, prefix = "cell") {
        return arr.map((item, index) => {
          const num = index + 1;
          return `<div class="num-cell ${prefix}-${num}">${escapeHtml(item)}</div>`;
        }).join("");
      }

      function formatSyairText(text) {
        return String(text || "")
          .replace(/\r/g, "")
          .split("\n")
          .map(line => line.replace(/\s+/g, " ").trim())
          .filter(line => line !== "")
          .join("<br>");
      }

      function renderSyairPreview() {
        updateSyairCopyText();

        const preview = document.getElementById("syairPreviewArea");
        if (!preview) return;

        if (!currentSyairNumbers) {
          currentSyairNumbers = generateSyairNumbers();
        }

        const marketKey = getElValue("syairMarketSelect", "BANGKOK");
        const shio = getElValue("syairShioSelect", "NAGA");
        const dateValue = getElValue("syairDateInput", getTodayInputValue());
        const rawSyairText = getElValue("syairTextArea", "");
        const syairText = rawSyairText.trim() ? formatSyairText(rawSyairText) : "Tulis syair di sini...";
        const dateInfo = formatSyairDateParts(dateValue);
        const cfg = syairMarketConfig[marketKey] || syairMarketConfig.BANGKOK;
        const shioUrl = shioImageMap[shio] || "";
        const n = currentSyairNumbers;

        preview.innerHTML = `
          <div class="syair-card" id="syairCardCapture">
            <img class="syair-bg" src="${escapeAttribute(SYAIR_TEMPLATE_URL)}" crossorigin="anonymous" alt="Template Syair">

            <div class="syair-date-box">
              <span class="day-name">${escapeHtml(dateInfo.weekday)}</span>
              <span class="full-date">${escapeHtml(dateInfo.longDate)}</span>
            </div>

            <div class="syair-shio-box">
              ${shioUrl ? `<img class="syair-shio-img" src="${escapeAttribute(shioUrl)}" crossorigin="anonymous" alt="${escapeAttribute(shio)}">` : ""}
            </div>

            <div class="syair-poem-box">${syairText}</div>

            <div class="syair-market-logo">
              <img src="${escapeAttribute(cfg.logo)}" crossorigin="anonymous" alt="${escapeAttribute(cfg.label)}">
            </div>

            <div class="syair-label-mini syair-label-bb">BB</div>
            <div class="syair-label-mini syair-label-colok">COLOK</div>
            <div class="syair-label-mini syair-label-jaga">JAGA</div>
            <div class="syair-label-mini syair-label-ekor">EKOR</div>
            <div class="syair-label-mini syair-label-kepala">KEPALA</div>
            <div class="syair-label-mini syair-label-bbfs">BBFS</div>
            <div class="syair-label-mini syair-label-shio">SHIO</div>
            <div class="syair-angka-main-label">ANGKA<br>MAIN</div>

            <div class="num-grid syair-bb-col">
              ${buildNumCells(n.bb, "bb-cell")}
            </div>

            <div class="syair-cross-top">${escapeHtml(n.arah[0])}</div>
            <div class="syair-cross-left">${escapeHtml(n.arah[1])}</div>
            <div class="syair-cross-right">${escapeHtml(n.arah[2])}</div>
            <div class="syair-cross-bottom">${escapeHtml(n.arah[3])}</div>

            <div class="num-grid syair-colok-grid">
              ${buildNumCells(n.colok, "colok-cell")}
            </div>

            <div class="num-grid syair-jaga-grid">
              ${buildNumCells(n.jaga, "jaga-cell")}
            </div>

            <div class="num-grid syair-ekor-grid">
              ${buildNumCells(n.ekor, "ekor-cell")}
            </div>

            <div class="num-grid syair-kepala-grid">
              ${buildNumCells(n.kepala, "kepala-cell")}
            </div>

            <div class="num-grid syair-bbfs-row">
              ${buildNumCells(n.bbfs, "bbfs-cell")}
            </div>

            <div class="num-grid syair-main-l-grid">
              ${buildNumCells([...n.angkaMain, ...n.jitu], "mainl-cell")}
            </div>
          </div>
        `;
      }

      function generateSyairPreview() {
        currentSyairNumbers = generateSyairNumbers();
        renderSyairPreview();
        updateStatus("Preview syair berhasil digenerate");
      }

      function resetSyairForm() {
        const dateEl = document.getElementById("syairDateInput");
        const marketEl = document.getElementById("syairMarketSelect");
        const shioEl = document.getElementById("syairShioSelect");
        const textEl = document.getElementById("syairTextArea");

        if (dateEl) dateEl.value = getTodayInputValue();
        if (marketEl) marketEl.value = "BANGKOK";
        if (shioEl) shioEl.value = "NAGA";
        if (textEl) textEl.value = "";

        currentSyairNumbers = generateSyairNumbers();
        renderSyairPreview();
        updateStatus("Form syair direset");
      }

      function copySyairText() {
        const header = getElValue("syairCopyText");
        const shio = getElValue("syairShioSelect", "NAGA");
        const text = getElValue("syairTextArea", "");
        const finalText = `${header}\nSHIO: ${shio}\n\n${text}`;

        const onSuccess = () => updateStatus("Text syair berhasil dicopy");
        const onFail = () => updateStatus("Gagal copy text syair");

        if (navigator.clipboard && window.isSecureContext) {
          navigator.clipboard.writeText(finalText).then(onSuccess).catch(() => fallbackCopy(finalText, onSuccess, onFail));
        } else {
          fallbackCopy(finalText, onSuccess, onFail);
        }
      }

      function waitForImagesLoaded(container) {
        const images = Array.from(container.querySelectorAll("img"));
        if (!images.length) return Promise.resolve();

        return Promise.all(
          images.map(img => {
            if (img.complete) return Promise.resolve();
            return new Promise(resolve => {
              img.onload = resolve;
              img.onerror = resolve;
            });
          })
        );
      }

      async function copySyairImage() {
        const target = document.getElementById("syairCardCapture");
        if (!target) return;

        try {
          await waitForImagesLoaded(target);

          const canvas = await html2canvas(target, {
            scale: 2,
            useCORS: true,
            allowTaint: false,
            backgroundColor: null,
            logging: false
          });

          const blob = await new Promise(resolve => canvas.toBlob(resolve, "image/png"));
          if (!blob) return;

          if (navigator.clipboard && window.ClipboardItem && window.isSecureContext) {
            await navigator.clipboard.write([
              new ClipboardItem({
                "image/png": blob
              })
            ]);
            updateStatus("Gambar syair berhasil dicopy");
          } else {
            const url = URL.createObjectURL(blob);
            const a = document.createElement("a");
            a.href = url;
            a.download = "syair-togel.png";
            document.body.appendChild(a);
            a.click();
            a.remove();
            URL.revokeObjectURL(url);
            updateStatus("Browser tidak support copy image, gambar didownload otomatis");
          }
        } catch (err) {
          console.error(err);
          updateStatus("Gagal copy image syair");
        }
      }

      function loadAllData() {
        let loaded = 0;
        const total = 4;

        function done(msg) {
          loaded++;
          updateStatus(`${msg} (${loaded}/${total})`);
          if (loaded === total) {
            initPrediksiData();
            renderStaticImageCards(staticImageData);
            initSyairGenerator();
            showPkcsPrompt();
            updateStatus("Semua data berhasil dimuat");
          }
        }

        google.script.run
          .withSuccessHandler(data => {
            dashboardData.dropdown1 = data || [];
            done("PK CS berhasil dimuat");
          })
          .withFailureHandler(() => {
            dashboardData.dropdown1 = [];
            done("PK CS gagal dimuat");
          })
          .getDropdownData1();

        google.script.run
          .withSuccessHandler(data => {
            dashboardData.dropdown2 = data || [];
            done("Prediksi berhasil dimuat");
          })
          .withFailureHandler(() => {
            dashboardData.dropdown2 = [];
            done("Prediksi gagal dimuat");
          })
          .getDropdownData2();

        google.script.run
          .withSuccessHandler(data => {
            dashboardData.dropdown3 = data || [];
            done("Data rekening berhasil dimuat");
          })
          .withFailureHandler(() => {
            dashboardData.dropdown3 = [];
            done("Data rekening gagal dimuat");
          })
          .getDropdownData3();

        google.script.run
          .withSuccessHandler(data => {
            dashboardData.dropdown4 = data || [];
            done("Kolom A berhasil dimuat");
          })
          .withFailureHandler(() => {
            dashboardData.dropdown4 = [];
            done("Kolom A gagal dimuat");
          })
          .getDropdownData4();
      }

      function initPrediksiData() {
        filteredPrediksiData = [...(dashboardData.dropdown2 || [])];
        selectedPrediksiIndex = filteredPrediksiData.length ? 0 : -1;
        renderPrediksiList(filteredPrediksiData);

        const resultEl = document.getElementById("prediksiResultCard");
        if (resultEl) {
          resultEl.textContent = filteredPrediksiData.length ? (filteredPrediksiData[0][1] || "-") : "Tidak ada hasil prediksi.";
        }
      }

      function initSyairGenerator() {
        const dateEl = document.getElementById("syairDateInput");
        const marketEl = document.getElementById("syairMarketSelect");
        const shioEl = document.getElementById("syairShioSelect");
        const textEl = document.getElementById("syairTextArea");

        if (dateEl && !dateEl.value) dateEl.value = getTodayInputValue();
        if (marketEl) marketEl.addEventListener("change", renderSyairPreview);
        if (shioEl) shioEl.addEventListener("change", renderSyairPreview);
        if (dateEl) dateEl.addEventListener("change", renderSyairPreview);
        if (textEl) textEl.addEventListener("input", renderSyairPreview);

        currentSyairNumbers = generateSyairNumbers();
        renderSyairPreview();
      }

      function initKeyboardShortcuts() {
        document.addEventListener("keydown", function(event) {
          const isAltC = event.altKey && (event.key === "c" || event.key === "C");
          const isAltX = event.altKey && (event.key === "x" || event.key === "X");
          const isEscape = event.key === "Escape";

          if (isAltC) {
            const pkcsSection = document.getElementById("pkcsSection");
            if (pkcsSection && pkcsSection.classList.contains("active")) {
              event.preventDefault();
              copyPkcsResult();
            }
          }

          if (isAltX) {
            const prediksiSection = document.getElementById("prediksiSection");
            if (prediksiSection && prediksiSection.classList.contains("active")) {
              event.preventDefault();
              copyPrediksiResult();
            }
          }

          if (isEscape) closeImageModal();
        });
      }

      window.onload = function() {
        initSidebar();
        initKeyboardShortcuts();
        startLiveClock();
        loadAllData();
      };
    </script>
  </body>
</html>
