        listEl.innerHTML = data.map((row, index) => `
          <div class="pkcs-keyword-item ${index === selectedPkcsIndex ? "active" : ""}" onclick="selectPkcsItem(${index})">
            ${escapeHtml(row[0])}
          </div>
        `).join("");
      }

